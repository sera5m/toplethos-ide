{
  "name": "toplethos",
  "displayName": "Toplethos",
  "description": "Toplethos 1.0 source editor for .tpth_s. Not Rust.",
  "version": "1.0.0",
  "publisher": "sera5m",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:toplethos"],
  "contributes": {
    "languages": [
      {
        "id": "toplethos",
        "aliases": ["Toplethos", "tpth"],
        "extensions": [".tpth_s", ".vul"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "tpth-aot",
        "aliases": ["Toplethos AOT", "tpth_aot"],
        "extensions": [".tpth_aot", ".cvul"]
      },
      {
        "id": "tpth-bc",
        "aliases": ["Toplethos bytecode", "tpth_bc"],
        "extensions": [".tpth_bc", ".bvul"]
      }
    ],
    "grammars": [{
      "language": "toplethos",
      "scopeName": "source.toplethos",
      "path": "./syntaxes/toplethos.tmLanguage.json"
    }],
    "configurationDefaults": {
      "[toplethos]": {
        "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordBasedSuggestions": "off"
      }
    }
  }
}
