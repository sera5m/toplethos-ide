{
  "name": "toplethos",
  "displayName": "Toplethos",
  "description": "Normal editor mode for .vul: highlighting and completions from the open file.",
  "version": "0.2.0",
  "publisher": "sera5m",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:toplethos"],
  "contributes": {
    "languages": [{
      "id": "toplethos",
      "aliases": ["Toplethos", "vul"],
      "extensions": [".vul", ".bvul"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "toplethos",
      "scopeName": "source.toplethos",
      "path": "./syntaxes/toplethos.tmLanguage.json"
    }],
    "configurationDefaults": {
      "[toplethos]": {
        "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordBasedSuggestions": "off"
      }
    }
  }
}
