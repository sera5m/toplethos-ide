{
  "scopeName": "source.toplethos",
  "name": "Toplethos",
  "patterns": [
    { "include": "#marker" },
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" }
  ],
  "repository": {
    "marker": {
      "match": "^//<<<.*>>>",
      "name": "markup.inserted.toplethos"
    },
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.toplethos"
    },
    "string": {
      "match": "\"(?:\\.|[^\"\\])*\"",
      "name": "string.quoted.double.toplethos"
    },
    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.toplethos"
    },
    "keyword": {
      "match": "\\b(fn|in|out|include|native|print|if|else|return|true|false)\\b",
      "name": "keyword.control.toplethos"
    }
  }
}
